# ===== 复制为 .env 后按需修改；全部都有默认值，零配置可跑 =====

# --- 数据库：默认 SQLite 零配置；MySQL 示例见下 ---
# Omit DATABASE_URL to use the absolute .data/mbses.db default.
# DATABASE_URL=mysql+pymysql://mbses:your-password@127.0.0.1:3307/mbses?charset=utf8mb4

# --- 缓存：memory（默认，进程内） / redis ---
CACHE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0

# --- 向量库：numpy（默认，向量存MySQL/SQLite） / milvus ---
VECTOR_BACKEND=numpy
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=mbses_kb_chunk_v2

# --- 大模型：mock（默认） / qwen ---
LLM_BACKEND=mock
# --- 向量化：mock（默认） / qwen ---
EMBEDDING_BACKEND=mock

# --- 百炼（通义千问）OpenAI 兼容接口 ---
QWEN_API_KEY=
ALLOW_PAID_MODEL_CALLS=false
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_EMBED_MODEL=text-embedding-v4
QWEN_OUTPUT_MODE=json_object

# --- 检索与生成参数（与技术设计文档一致） ---
EMBED_DIM=1024
TOP_K=12
FINAL_CHUNKS=6
TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
CACHE_TTL_SECONDS=600
RESPONSE_CACHE_TTL=1800
CHUNK_TARGET_CHARS=600
CHUNK_OVERLAP_CHARS=80
MAX_CONTEXT_CHARS=12000
# Case data is private and is not distributed with the repository.
MBSES_CASE_SOURCE=private/toothbrush_case.docx
